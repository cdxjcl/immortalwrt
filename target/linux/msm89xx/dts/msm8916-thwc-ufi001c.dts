/dts-v1/;

#include "msm8916-ufi.dtsi"

/ {
	model = "ufi-001c 4G Modem Stick";
	compatible = "thwc,ufi001c", "qcom,msm8916";
	leds: leds {
		sim_sel {
			label = "sim:sel";
			gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		sim_en {
			label = "sim:en";
			gpios = <&tlmm 1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		sim_sel2 {
			label = "sim:sel2";
			gpios = <&tlmm 0 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		sim_en2 {
			label = "sim:en2";
			gpios = <&tlmm 3 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};


&button_restart {
	gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
};

&led_r {
	gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
};

&led_g {
	gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
};

&led_b {
	gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
};

&mpss {
	pinctrl-0 = <&sim_ctrl_default>;
	pinctrl-names = "default";
};

&button_default {
	pins = "gpio37";
	bias-pull-down;
};

&gpio_leds_default {
	pins = "gpio0","gpio1","gpio2","gpio3","gpio20", "gpio21", "gpio22";
};

/* This selects the external SIM card slot by default */
&tlmm {
	sim_ctrl_default: sim-ctrl-default-state {
		esim-sel-pins {
			pins = "gpio0", "gpio3";
			bias-disable;
			output-low;
		};

		sim-en-pins {
			pins = "gpio1";
			bias-disable;
			output-low;
		};

		sim-sel-pins {
			pins = "gpio2";
			bias-disable;
			output-high;
		};
	};
};

/*
 * UFI-16-V3 LED mapping:
 *   red   -> TLMM GPIO8
 *   green -> PM8916 MPP4
 *   blue  -> TLMM GPIO32
 */
&leds {
	status = "disabled";
};

/ {
	user-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&user_leds_default>;

		led-g {
			gpios = <&pm8916_mpps 4 GPIO_ACTIVE_HIGH>;
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			default-state = "off";
		};

		led-b {
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_BLUE>;
			default-state = "off";
		};

		led-r {
			gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_RED>;
			default-state = "on";
		};
	};
};

&tlmm {
	user_leds_default: user-leds-default-state {
		pins = "gpio8", "gpio32";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};
